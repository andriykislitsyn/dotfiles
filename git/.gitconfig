[user]
	name = Your Name                    # CHANGEME
	email = your.email@example.com      # CHANGEME
	signingkey = YOUR_GPG_KEY_ID        # CHANGEME

[alias]
	# Pull with rebase, prune dead remotes, update submodules — one command
	# https://haacked.com/archive/2014/07/28/github-flow-aliases/
	up = !git pull --rebase --prune $@ && git submodule update --init --recursive
	co = checkout
	cob = checkout -b
	cm = !git add -A && git commit -m
	save = !git add -A && git commit -m 'SAVEPOINT'
	wip = commit -am "WIP"
	undo = reset HEAD~1 --mixed
	amend = commit -a --amend

	# Nuclear option: stage everything, commit, then hard reset — leaves reflog trail
	wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard

	# Clean up merged branches
	bclean = "!f() { git checkout ${1-master} && git branch --merged ${1-master} | grep -v \" ${1-master}$\" | xargs git branch -d; }; f"
	bdone = "!f() { git checkout ${1-master} && git up && git bclean ${1-master}; }; f"
	trim = "!f() { git branch | grep -v '^\\*' | xargs git branch -d; }; f"

	# Compact colored log
	# https://coderwall.com/p/euwpig/a-better-git-log
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

	# Detailed graph log
	grog = log --graph --abbrev-commit --decorate --all --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)\"

	# Force push, but only if nobody else pushed first
	# https://hackernoon.com/lesser-known-git-commands-151a1918a60
	please = push --force-with-lease

	# Amend without changing the message
	commend = commit --amend --no-edit

	# Short status with branch info
	st = status -sb -uall

	# Push current branch to remote (set upstream on first push)
	bonk = push --set-upstream origin HEAD

	# Squash current branch to merge-base
	squash = "!f() { git reset $(git merge-base ${1-master} $(git rev-parse --abbrev-ref HEAD)); }; f"

	# Recent branches by date
	branchdate = for-each-ref --count=10 --sort=-committerdate refs/heads/ --format="%(authordate:short)%09%(objectname:short)%09%1B[0;33m%(refname:short)%1B[m%09"

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[push]
	autoSetupRemote = true

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[credential]
	helper = osxkeychain

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
